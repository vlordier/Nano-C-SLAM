{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nano-c-slam.invalid/schemas/gap9-mapping-diagnostic-v2.json",
  "title": "Nano-C-SLAM shared host/GVSOC mapping diagnostic",
  "description": "Synthetic fixture evidence only. Host PMSIS stubs and GVSOC target execution are distinct evidence classes; neither is hardware or flight validation. Version 2 binds owned source files and retained target logs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "evidence_class", "claim_boundary", "hardware_measurement", "fixture", "build", "execution", "mapping"],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"enum": ["passed", "failed", "reproduced-limitation"]},
    "evidence_class": {"enum": ["host-pmsis-stubs", "gvsoc-target-execution"]},
    "claim_boundary": {"type": "string", "minLength": 1},
    "hardware_measurement": {"const": false},
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "source_sha256", "pose_count", "scan_count", "point_count"],
      "properties": {
        "name": {"const": "gap9_sdk_gvsoc_mapping_smoke"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "pose_count": {"const": 60},
        "scan_count": {"const": 3},
        "point_count": {"const": 240}
      }
    },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["toolchain_id", "compiler_flags", "binary_sha256", "source_sha256", "sdk_metadata", "compiler_commands_sha256"],
      "properties": {
        "toolchain_id": {"type": "string", "minLength": 1},
        "compiler_flags": {"type": "string", "minLength": 1},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "compiler_commands_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "sdk_metadata": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["revision", "release", "worktree_dirty"],
              "properties": {
                "revision": {"type": "string", "minLength": 1},
                "release": {"type": "string", "minLength": 1},
                "worktree_dirty": {"type": "boolean"}
              }
            }
          ]
        }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["exit_code", "marker_seen", "terminated", "log_sha256", "log_bytes"],
      "properties": {
        "exit_code": {"type": "integer", "minimum": -255, "maximum": 255},
        "marker_seen": {"type": "boolean"},
        "terminated": {"const": true},
        "log_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "log_bytes": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]}
      }
    },
    "mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["poses", "scans", "points", "finite_poses", "has_nan", "icp_attempts", "correspondences_last_pair", "icp_error_milli", "icp_has_nan", "accepted_constraints", "graph_nodes", "optimizer_input_constraints", "optimizer_unique_edges", "main_solver_returned", "successful_solver_calls", "completed_solver_iterations", "optimization_completed"],
      "properties": {
        "poses": {"type": "integer", "minimum": 0},
        "scans": {"type": "integer", "minimum": 0},
        "points": {"type": "integer", "minimum": 0},
        "finite_poses": {"type": "integer", "minimum": 0},
        "has_nan": {"type": "boolean"},
        "icp_attempts": {"type": ["integer", "null"], "minimum": 0},
        "correspondences_last_pair": {"type": ["integer", "null"], "minimum": 0},
        "icp_error_milli": {"type": ["integer", "null"]},
        "icp_has_nan": {"type": ["boolean", "null"]},
        "accepted_constraints": {"type": ["integer", "null"], "minimum": 0},
        "graph_nodes": {"type": ["integer", "null"], "minimum": 0},
        "optimizer_input_constraints": {"type": ["integer", "null"], "minimum": 0},
        "optimizer_unique_edges": {"type": ["integer", "null"], "minimum": 0},
        "main_solver_returned": {"type": ["boolean", "null"]},
        "successful_solver_calls": {"type": ["integer", "null"], "minimum": 0},
        "completed_solver_iterations": {"type": ["integer", "null"], "minimum": 0},
        "optimization_completed": {"type": ["boolean", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_class": {"const": "host-pmsis-stubs"}}},
      "then": {
        "properties": {
          "build": {"properties": {"sdk_metadata": {"type": "null"}, "compiler_commands_sha256": {"type": "null"}}},
          "execution": {"properties": {"log_sha256": {"type": "null"}, "log_bytes": {"type": "null"}}}
        }
      },
      "else": {
        "properties": {
          "build": {"properties": {"sdk_metadata": {"type": "object"}, "compiler_commands_sha256": {"$ref": "#/$defs/sha256"}}},
          "execution": {"properties": {"log_sha256": {"$ref": "#/$defs/sha256"}, "log_bytes": {"type": "integer", "minimum": 1}}}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
